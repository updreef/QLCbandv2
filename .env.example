# ── Supabase (CMS + leads-inbox) ─────────────────────────────
# Maak een gratis project op https://supabase.com → Project Settings → API.
# Zonder deze twee waardes werkt de site gewoon: content valt terug op
# src/data.ts en het contactformulier stuurt alleen e-mail.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── E-mailnotificatie bij nieuwe boekingsaanvraag (Resend) ───
# Maak een gratis account op https://resend.com → API Keys.
# Zonder key wordt er geen mail gestuurd; de lead komt dan alleen
# in de Supabase-inbox (admin) terecht.
RESEND_API_KEY=

# Ontvanger van boekingsaanvragen.
# TODO: wissel naar de QLC-band-mailbox zodra die bestaat.
CONTACT_EMAIL=Ruben_beukers@outlook.com
